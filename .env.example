# Expensif Environment Configuration
# Copy to .env and adjust for your setup

# Port the Go server listens on (default: 8080)
PORT=8080

# Directory for SQLite database (default: ~/.expensif)
# In Docker, this should match your volume mount target
DATA_DIR=/data

# Server timezone fallback (default: system local timezone)
# Used when no timezone preference is set. Set to your IANA zone, e.g.:
# TZ=Asia/Kuala_Lumpur
TZ=UTC
